{
  "name": "obwat",
  "version": "0.2.0",
  "description": "O Brother Where Art Thou — Brother P-touch raster printing from the browser (WebUSB / Web Serial)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/obwat.git"
  },
  "homepage": "https://github.com/orochi235/obwat#readme",
  "bugs": {
    "url": "https://github.com/orochi235/obwat/issues"
  },
  "keywords": [
    "brother",
    "p-touch",
    "pt-p710bt",
    "label-printer",
    "webusb",
    "web-serial",
    "raster",
    "printing",
    "browser"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "typedoc",
    "prepublishOnly": "npm test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "typedoc": "^0.28.20",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
